{
  "schema_version": "1.0.0",
  "screen_id": "mock-main",
  "project_id": "demo",
  "name": "Mock Main Screen",
  "canvas_width": 1280,
  "canvas_height": 720,
  "objects": [
    {
      "object_id": "pump-001",
      "svg_asset_id": "pump-symbol",
      "x": 80,
      "y": 120,
      "width": 120,
      "height": 120,
      "tag_bindings": {
        "state": "mock.running.001",
        "value": "mock.temperature.001"
      },
      "modify_rules": [
        {
          "property": "visible",
          "binding_key": "state",
          "true_value": "true",
          "false_value": "false",
          "condition": {
            "op": "eq",
            "value": true
          }
        },
        {
          "property": "color",
          "binding_key": "value",
          "true_value": "#cc3333",
          "false_value": "#3cb371",
          "condition": {
            "any": [
              { "op": "lt", "value": 18 },
              { "op": "gt", "value": 28 }
            ]
          }
        }
      ]
    },
    {
      "object_id": "label-001",
      "svg_asset_id": "text-label",
      "x": 240,
      "y": 140,
      "width": 280,
      "height": 48,
      "tag_bindings": {
        "value": "mock.temperature.001"
      },
      "modify_rules": [
        {
          "property": "text",
          "binding_key": "value",
          "true_value": "NORMAL",
          "false_value": "CHECK",
          "condition": {
            "all": [
              { "op": "gte", "value": 20 },
              { "op": "lte", "value": 26 }
            ]
          }
        }
      ]
    }
  ]
}
