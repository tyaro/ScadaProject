{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scada.local/schemas/screen-definition.schema.json",
  "title": "ScreenDefinition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "screen_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "canvas_width": { "type": "integer", "minimum": 1 },
    "canvas_height": { "type": "integer", "minimum": 1 },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": { "type": "string", "minLength": 1 },
          "svg_asset_id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "tag_bindings": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "modify_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "property": { "type": "string", "minLength": 1 },
                "binding_key": { "type": "string", "minLength": 1 },
                "true_value": { "type": "string" },
                "false_value": { "type": "string" }
              },
              "required": ["property", "binding_key"]
            }
          }
        },
        "required": ["object_id", "svg_asset_id", "x", "y", "width", "height"]
      }
    }
  },
  "required": ["schema_version", "screen_id", "project_id", "name", "canvas_width", "canvas_height", "objects"]
}

